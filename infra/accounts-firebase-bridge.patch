diff --git a/lambda/firebase.mjs b/lambda/firebase.mjs
new file mode 100644
index 0000000..d9c05c0
--- /dev/null
+++ b/lambda/firebase.mjs
@@ -0,0 +1,51 @@
+// Firebase bridge: swap an accounts access token for a Firebase custom token, so an app keeps Firebase
+// Auth underneath (security rules, App Check, AI Logic) while accounts stays the one sign-in.
+//   POST /t/{tenant}/v1/firebase/{projectId}/token   Authorization: Bearer <accounts access token>
+//   → { token, uid, email, expires_in }   then the app calls signInWithCustomToken(token)
+// The project's service-account JSON is the SSM SecureString /accounts/firebase/{tenant}/{projectId}.
+// No parameter = the project isn't enabled for that tenant (404). The Firebase uid is the accounts sub.
+import { SignJWT, importPKCS8 } from 'jose'
+
+const AUDIENCE = 'https://identitytoolkit.googleapis.com/google.identity.identitytoolkit.v1.IdentityToolkit'
+export const FIREBASE_TOKEN_TTL = 3600 // the most Firebase accepts
+export const PROJECT_ID = /^[a-z][a-z0-9-]{4,28}[a-z0-9]$/
+
+export const firebaseParamName = (tenant, projectId) => `/accounts/firebase/${tenant}/${projectId}`
+
+const keyCache = new WeakMap()
+async function signingKey (sa) {
+  if (!keyCache.has(sa)) keyCache.set(sa, importPKCS8(sa.private_key, 'RS256'))
+  return keyCache.get(sa)
+}
+
+/** A Firebase custom token for `uid`, signed with the project's service account. */
+export async function mintFirebaseToken (sa, uid, claims, nowMs) {
+  if (!sa?.client_email || !sa?.private_key) throw new Error('firebase: service account needs client_email and private_key')
+  const iat = Math.floor(nowMs / 1000)
+  return new SignJWT({ uid, claims })
+    .setProtectedHeader({ alg: 'RS256', typ: 'JWT' })
+    .setIssuer(sa.client_email)
+    .setSubject(sa.client_email)
+    .setAudience(AUDIENCE)
+    .setIssuedAt(iat)
+    .setExpirationTime(iat + FIREBASE_TOKEN_TTL)
+    .sign(await signingKey(sa))
+}
+
+/** Loader for production: reads and caches the SSM parameter (misses are cached briefly). */
+export function makeFirebaseKeyLoader (ssm, GetParametersCommand, { missTtlMs = 60_000 } = {}) {
+  const cache = new Map()
+  return async (tenant, projectId) => {
+    const name = firebaseParamName(tenant, projectId)
+    const hit = cache.get(name)
+    if (hit && (hit.sa || Date.now() - hit.at < missTtlMs)) return hit.sa
+    let sa = null
+    try {
+      const r = await ssm.send(new GetParametersCommand({ Names: [name], WithDecryption: true }))
+      const v = r.Parameters?.[0]?.Value
+      if (v) sa = JSON.parse(v)
+    } catch (e) { console.error('firebase key load', name, e.name) }
+    cache.set(name, { sa, at: Date.now() })
+    return sa
+  }
+}
