diff --git a/test/firebase.test.mjs b/test/firebase.test.mjs
new file mode 100644
index 0000000..c16810b
--- /dev/null
+++ b/test/firebase.test.mjs
@@ -0,0 +1,55 @@
+import { test, before, after } from 'node:test'
+import assert from 'node:assert/strict'
+import { generateKeyPair, exportPKCS8, jwtVerify, decodeProtectedHeader } from 'jose'
+import { startServer, jar, req, signIn } from './helpers.mjs'
+import { putClient, toOidcMetadata } from '../lambda/tenants.mjs'
+
+const AUD = 'https://identitytoolkit.googleapis.com/google.identity.identitytoolkit.v1.IdentityToolkit'
+let srv, publicKey, sa
+before(async () => {
+  const kp = await generateKeyPair('RS256', { extractable: true })
+  publicKey = kp.publicKey
+  sa = { client_email: 'firebase-adminsdk@demo-proj.iam.gserviceaccount.com', private_key: await exportPKCS8(kp.privateKey) }
+  const loadFirebaseKey = async (tenant, project) => (tenant === 'mattricks' && project === 'demo-proj' ? sa : null)
+  srv = await startServer({ tenants: ['mattricks', 'other'], extraConfig: { loadFirebaseKey } })
+})
+after(() => srv.close())
+
+const post = (tenant, project, token) => req(null, `${srv.baseUrl}/t/${tenant}/v1/firebase/${project}/token`, { method: 'POST', headers: token ? { authorization: `Bearer ${token}` } : {} })
+
+test('a signed-in user gets a Firebase custom token for an enabled project', async () => {
+  const t = await signIn(srv, jar(), 'mattricks', 'fb@x.com')
+  const r = await post('mattricks', 'demo-proj', t.access_token)
+  assert.equal(r.status, 200)
+  const body = await r.json()
+  assert.match(body.uid, /^usr_/)
+  assert.equal(body.email, 'fb@x.com')
+  assert.equal(body.expires_in, 3600)
+  assert.equal(decodeProtectedHeader(body.token).alg, 'RS256')
+  const { payload } = await jwtVerify(body.token, publicKey, { audience: AUD, issuer: sa.client_email, subject: sa.client_email })
+  assert.equal(payload.uid, body.uid)
+  assert.deepEqual(payload.claims, { tid: 'mattricks', email: 'fb@x.com' })
+  assert.equal(payload.exp - payload.iat, 3600)
+  assert.ok(srv.events.some(([e, p]) => e === 'firebase_token' && p.project === 'demo-proj'))
+})
+
+test('no token is 401; unknown or malformed project is 404; another tenant cannot use the key', async () => {
+  assert.equal((await post('mattricks', 'demo-proj')).status, 401)
+  const t = await signIn(srv, jar(), 'mattricks', 'fb2@x.com')
+  assert.equal((await post('mattricks', 'not-enabled', t.access_token)).status, 404)
+  assert.equal((await post('mattricks', 'Bad_Project', t.access_token)).status, 404)
+  const o = await signIn(srv, jar(), 'other', 'fb3@x.com')
+  assert.equal((await post('other', 'demo-proj', o.access_token)).status, 404)
+  assert.equal((await post('mattricks', 'demo-proj', o.access_token)).status, 401)
+})
+
+test('clients with app-scheme redirects are native; https-only clients stay web', async () => {
+  await putClient(srv.store, 'mattricks', { client_id: 'mobile', client_name: 'Mobile', redirect_uris: ['com.example.app:/oauth2redirect'] })
+  assert.equal(toOidcMetadata({ redirect_uris: ['com.example.app:/oauth2redirect'] }).application_type, 'native')
+  assert.equal(toOidcMetadata({ redirect_uris: ['https://app.test/cb', 'http://localhost:5173/'] }).application_type, 'web')
+  // The provider itself must accept the app-scheme redirect (an invalid one renders a 400 error page instead).
+  const q = new URLSearchParams({ client_id: 'mobile', redirect_uri: 'com.example.app:/oauth2redirect', response_type: 'code', scope: 'openid email offline_access', code_challenge: 'E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM', code_challenge_method: 'S256', prompt: 'consent' })
+  const r = await fetch(`${srv.baseUrl}/t/mattricks/auth?${q}`, { redirect: 'manual' })
+  assert.ok([302, 303].includes(r.status), `expected redirect to sign-in, got ${r.status}`)
+  assert.doesNotMatch(r.headers.get('location') ?? '', /error=/)
+})
