<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window behind Compose: the token paper colour, so launch and transitions never flash white in dark mode. -->
    <style name="Theme.Verified" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="paper">#E8ECE4</color>
</resources>
