# Copy to .env.local (git-ignored) and fill in from Firebase console -> Project settings -> Web app,
# or from config/web-config.json of the verified-core worktree.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=verified-99e74
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (Firebase AI Logic). reCAPTCHA Enterprise site key for the web app.
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Local dev only (put in .env.development.local):
# VITE_APPCHECK_DEBUG=true
# VITE_APPCHECK_DEBUG_TOKEN=

# Talk to the Firebase Emulator Suite (auth 9099, firestore 8080) instead of production.
# VITE_USE_EMULATORS=true
# VITE_EMULATOR_HOST=127.0.0.1

# Render the feed and detail pages from built-in sample data, with no Firebase at all.
# VITE_FIXTURES=true
