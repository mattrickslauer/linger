# infra/setup-firebase.sh writes these for you. To do it by hand:
# copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). reCAPTCHA Enterprise site key registered in
# Firebase console → App Check → Apps → your web app.
VITE_RECAPTCHA_ENTERPRISE_KEY=

# Local development only. Put these in .env.development.local (NOT .env.local, which Vite also
# loads for production builds), and register the token under App Check → Manage debug tokens.
# VITE_APPCHECK_DEBUG=true
# VITE_APPCHECK_DEBUG_TOKEN=
