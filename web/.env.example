# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). reCAPTCHA Enterprise site key from
# Firebase console → App Check → Apps → your web app.
VITE_RECAPTCHA_ENTERPRISE_KEY=

# Local development / judge testing: use the App Check debug provider.
# With VITE_APPCHECK_DEBUG=true and no token, the SDK prints one in the console; register it
# under App Check → Apps → Manage debug tokens. Never commit a real token.
VITE_APPCHECK_DEBUG=false
VITE_APPCHECK_DEBUG_TOKEN=
