{
  "name": "verified-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "VITE_FIXTURES=true vite",
    "dev:emu": "VITE_USE_EMULATORS=true vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "shots": "node scripts/shots.mjs",
    "e2e:emu": "node scripts/e2e-emu.mjs",
    "vault:emu": "node scripts/vault-emu.mjs",
    "check:guest": "node scripts/guest-check.mjs",
    "check:ladder": "node scripts/ladder-check.mjs"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
