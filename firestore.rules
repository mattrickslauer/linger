rules_version = '2';

// Verified — authoritative security rules. Contract: docs/ARCHITECTURE.md.
// The seal and the public feed are written ONLY by the Cloud Function (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPublicStatus(status) {
      return status in ['sealed', 'rejected'];
    }

    // ── public feed: read by anyone, written by nobody (Function only)
    match /feed/{momentId} {
      allow read: if true;
      allow write: if false;
    }

    // ── user profiles
    match /users/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ── moments
    match /moments/{momentId} {
      function sealUnsetOnCreate() {
        return !('seal' in request.resource.data) || request.resource.data.seal == null;
      }

      // `resource == null` lets an offline-first client probe a not-yet-synced id without a permission error.
      allow read: if resource == null
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isPublicStatus(resource.data.status);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'recording'
        && sealUnsetOnCreate();

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && resource.data.status in ['recording', 'submitted']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seal'])
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'recording' && request.resource.data.status == 'submitted'));

      allow delete: if false;

      // ── chunks: append-only
      match /chunks/{seq} {
        function parent() {
          return get(/databases/$(database)/documents/moments/$(momentId)).data;
        }

        allow read: if (signedIn() && parent().ownerUid == request.auth.uid)
          || isPublicStatus(parent().status);

        allow create: if signedIn()
          && parent().ownerUid == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.seq == int(seq)
          && (parent().status == 'recording'
              || (parent().status == 'submitted' && request.resource.data.seq < parent().chunkCount));

        allow update, delete: if false;
      }
    }
  }
}
