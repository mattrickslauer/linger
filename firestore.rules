rules_version = '2';

// Verified — authoritative security rules. Contract: docs/ARCHITECTURE.md.
// The seal and the public feed are written ONLY by the Cloud Function (Admin SDK bypasses rules).
// v3: the bar, the verification (final score + ladder results) and the credits ledger are also server-only.
// v4: the authoritative claims, the evidence plan and the video review are server-only too; the client's draft claims
// and plan live inside the intention (frozen once recording ends). Leases (barLeases, videoLeases) have no match: denied.
// Guests (not signed in) write nothing: they read the public feed and keep their Moments in the local raw vault
// until they sign in and claim them (docs/ARCHITECTURE.md "v3 · Guest mode").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPublicStatus(status) {
      return status in ['sealed', 'rejected'];
    }

    // ── public feed: read by anyone, written by nobody (Function only)
    // Tombstones written by onMomentDeleted. A raw vault checks here before re-creating a Moment the server lacks.
    // `resource == null` lets a client ask "was this deleted?" about an id that never was.
    match /deleted/{momentId} {
      allow read: if resource == null || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /feed/{momentId} {
      allow read: if true;
      allow write: if false;
    }

    // ── credits (v3): balance + ledger, readable by their owner, written ONLY by Cloud Functions
    // (getCredits grants the free demo credits; runLadderModule spends and refunds).
    match /credits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /ledger/{entryId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── user profiles
    match /users/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ── moments
    match /moments/{momentId} {
      // Fields only the Cloud Functions write. A client may create them as null (the raw vault re-creates with
      // seal: null), never with a value, and never change them afterwards.
      function serverOnlyKeys() {
        return ['seal', 'bar', 'verification', 'claims', 'plan', 'videoReview'];
      }
      function unsetOnCreate(k) {
        return !(k in request.resource.data) || request.resource.data[k] == null;
      }
      function serverFieldsUnsetOnCreate() {
        return unsetOnCreate('seal') && unsetOnCreate('bar') && unsetOnCreate('verification')
          && unsetOnCreate('claims') && unsetOnCreate('plan') && unsetOnCreate('videoReview');
      }
      // v4: the client's draft claims (≤ 5) and evidence plan (≤ 6 requirements) inside the intention.
      function draftOk(i) {
        return (!('claims' in i) || i.claims == null || (i.claims is list && i.claims.size() <= 5))
          && (!('plan' in i) || i.plan == null
              || (i.plan is map
                  && i.plan.requirements is list && i.plan.requirements.size() <= 6
                  && i.plan.recordMode in ['video', 'photo']));
      }
      function intentionOk() {
        return !('intention' in request.resource.data)
          || !(request.resource.data.intention is map)
          || draftOk(request.resource.data.intention);
      }

      // `resource == null` lets an offline-first client probe a not-yet-synced id without a permission error.
      allow read: if resource == null
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isPublicStatus(resource.data.status);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'recording'
        && serverFieldsUnsetOnCreate()
        && intentionOk();

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && resource.data.status in ['recording', 'submitted']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyKeys())
        // v3: the bar is computed from the intention at submit, so the intention is frozen once recording ends
        // (the recording → submitted update itself may still carry it).
        && (resource.data.status == 'recording'
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['intention']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['intention']) || intentionOk())
        && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'recording' && request.resource.data.status == 'submitted'));

      // Only the owner deletes, from "my Moments". The onMomentDeleted function then removes the chunks and the
      // feed entry and writes deleted/{momentId} so no device's raw vault re-creates it.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // ── chunks: append-only
      match /chunks/{seq} {
        function parent() {
          return get(/databases/$(database)/documents/moments/$(momentId)).data;
        }

        allow read: if (signedIn() && parent().ownerUid == request.auth.uid)
          || isPublicStatus(parent().status);

        allow create: if signedIn()
          && parent().ownerUid == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.seq == int(seq)
          && (parent().status == 'recording'
              || (parent().status == 'submitted' && request.resource.data.seq < parent().chunkCount));

        allow update, delete: if false;
      }
    }
  }
}
